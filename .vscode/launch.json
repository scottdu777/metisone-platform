{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Semantic Edit YAML Service",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "deployments.semantic_edit_yaml_service.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8088"
      ],
      "envFile": "${workspaceFolder}/deployments/semantic_edit_yaml_service/.env",
      "env": {
        "PYDEVD_USE_SYS_MONITORING": "NO"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug Semantic Client",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "metisone_ai_platform.semantic_client.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8090"
      ],
      "envFile": "${workspaceFolder}/deployments/semantic_client/.env",
      "env": {
        "PYDEVD_USE_SYS_MONITORING": "NO"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug Semantic Data Query Service",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "deployments.semantic_data_query_service.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8091"
      ],
      "envFile": "${workspaceFolder}/deployments/semantic_data_query_service/.env",
      "console": "integratedTerminal",
      "env": {
        "PYDEVD_USE_SYS_MONITORING": "NO"
      },
      "justMyCode": true
    }
  ]
}
