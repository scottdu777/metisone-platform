SEMANTIC_AGENT_MODE=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com
SEMANTIC_EDIT_SERVICE_URL=http://127.0.0.1:8088
SEMANTIC_EDIT_SERVICE_TOKEN=change-me
SEMANTIC_DATA_QUERY_SERVICE_URL=http://127.0.0.1:8091
SEMANTIC_DATA_QUERY_SERVICE_TOKEN=change-me
METISONE_REQUEST_LOG_FILE=logs/semantic_client_requests.jsonl
METISONE_REQUEST_LOG_MAX_BYTES=10485760
METISONE_REQUEST_LOG_BACKUP_COUNT=5
METISONE_REQUEST_LOG_MAX_BODY_BYTES=1048576
